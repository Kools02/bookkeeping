<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or 'TIN Input App' }}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f6f8fb; }
    .navbar-brand { font-weight: 700; }
    .card { border: 0; border-radius: 1rem; box-shadow: 0 10px 30px rgba(0,0,0,.05); }
    .table-responsive {
      border-radius: 1rem;
      overflow-x: auto;
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
    }
    .muted-label { font-size: .9rem; color: #6c757d; }
    .stat-number { font-size: 1.8rem; font-weight: 700; }
    .lookup-box { background: #eef6ff; border: 1px solid #cfe2ff; border-radius: .75rem; padding: 1rem; }
    .mobile-sticky { position: sticky; top: 0; z-index: 1020; }
    .nowrap-scroll,
    .value-scroll {
      display: block;
      max-width: 100%;
      white-space: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: thin;
      padding-bottom: .1rem;
    }
    .data-table {
      min-width: 1100px;
    }
    .data-table td,
    .data-table th {
      white-space: nowrap;
      vertical-align: middle;
    }
    .data-table .cat-cell { min-width: 82px; }
    .data-table .store-cell { min-width: 220px; max-width: 260px; }
    .data-table .address-cell { min-width: 240px; max-width: 300px; }
    .data-table .tin-cell { min-width: 160px; }
    .data-table .amount-cell { min-width: 96px; }
    .data-table .action-header,
    .data-table .action-cell {
      position: sticky;
      right: 0;
      min-width: 130px;
      background: #fff;
      z-index: 2;
      box-shadow: -1px 0 0 rgba(0,0,0,.08);
    }
    .data-table thead .action-header {
      background: var(--bs-table-bg, #f8f9fa);
      z-index: 4;
    }
    .action-buttons {
      display: inline-flex;
      flex-wrap: nowrap;
      justify-content: flex-end;
      gap: .4rem;
    }
    .action-buttons .btn {
      white-space: nowrap;
    }
    .lookup-box .value-scroll {
      padding-bottom: .15rem;
    }
    .pagination-wrap {
      overflow-x: auto;
      padding-top: .75rem;
    }
    .pagination {
      flex-wrap: nowrap;
    }
    @media (max-width: 991.98px) {
      .data-table {
        min-width: 980px;
      }
      .data-table .store-cell { min-width: 190px; max-width: 220px; }
      .data-table .address-cell { min-width: 220px; max-width: 250px; }
      .data-table .action-header,
      .data-table .action-cell { min-width: 122px; }
      .action-buttons .btn {
        padding: .25rem .5rem;
        font-size: .8rem;
      }
    }
  </style>
</head>
<body>
<nav class="navbar navbar-expand-lg bg-white border-bottom mobile-sticky">
  <div class="container py-2">
    <a class="navbar-brand" href="{{ url_for('index') }}">TIN Input App</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav ms-auto gap-lg-2">
        <li class="nav-item"><a class="nav-link" href="{{ url_for('index') }}">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url_for('manage_periods') }}">Months</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url_for('upload_reference') }}">Reference</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url_for('new_entry') }}">New Entry</a></li>
        <li class="nav-item"><a class="nav-link" href="{{ url_for('list_entries') }}">Entries</a></li>
      </ul>
    </div>
  </div>
</nav>

<div class="container py-4 py-lg-5">
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
      <div class="mb-4">
        {% for category, message in messages %}
          <div class="alert alert-{{ category }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  {% endwith %}

  {% block content %}{% endblock %}
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>
